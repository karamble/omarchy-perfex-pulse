#!/usr/bin/env bash
# Receivables from a Perfex CRM over its MCP connector, printed as ONE line
# of JSON for the bar widget (exit 0 always, errors as JSON too):
#
#   {"v":1,"ok":true,"updated":EPOCH,"fresh":true|false,"approx":false,
#    "currencies":[{"id":"2","symbol":"€","name":"EUR","outstanding":2500,
#       "overdue":{"count":1,"total":2500},"unpaid":{...},"partial":{...}}],   outstanding desc
#    "overdue_invoices":[{"id":15,"number":"INV-000014","clientid":4,"client":"...",
#       "symbol":"€","balance":2500,"duedate":"2026-08-06","days_overdue":27}],  duedate asc
#    "open_count":1,"skipped_gets":0,"balances":{"15":2500},
#    "paid_month":{"symbol":"€","total":0,"count":0,"rows":[]},"meta":{"calls":4,"ms":1800}}
#   {"v":1,"error":"off|no_key|key_perms|bad_endpoint|auth|forbidden|rate_limited|
#                   unreachable|server|tool_error|protocol|parse_failed|deadline","detail":"...","http":403}
#
# Usage: perfex-pulse-fetch [overdueRows] [--payments] [--force]
#
# Two things this script guarantees:
#  1. Zero traffic while the widget's "querying" switch is off. The switch
#     lives in ~/.config/omarchy/shell.json and is checked HERE, before the
#     key file is even opened - a hand-run script, a stale keybind or a QML
#     regression still makes no request.
#  2. The bearer token never appears in argv, the environment, stdout, stderr
#     or the cache: it is read descriptor-first from a 0600 file and handed
#     to curl as a config line on stdin (Stripe Revenue's pattern).
set -uo pipefail

PLUGIN_ID="karamble.perfex-pulse"
CONF_DIR="${PERFEX_PULSE_CONF_DIR:-$HOME/.config/perfex-pulse}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/perfex-pulse"
SHELL_JSON="${PERFEX_PULSE_SHELL_JSON:-$HOME/.config/omarchy/shell.json}"
# Tests: canned responses from files instead of the network (and no gate).
FIXTURE_DIR="${PERFEX_PULSE_FIXTURE_DIR:-}"

OVERDUE_ROWS="${1:-5}"
[[ "$OVERDUE_ROWS" =~ ^[0-9]+$ ]] && (( OVERDUE_ROWS <= 15 )) || OVERDUE_ROWS=5
WANT_PAYMENTS=0
FORCE=0
for arg in "${@:2}"; do
  case "$arg" in
    --payments) WANT_PAYMENTS=1 ;;
    --force) FORCE=1 ;;
  esac
done

GET_CAP=25          # invoices_get lookups per run; beyond it balances are approximate
PAGE_CAP=5          # pages of 100 per list
RESULT_TTL=60       # seconds a successful result is served from cache
CUSTOMERS_TTL=86400
START_MS=$(( $(date +%s%N) / 1000000 ))
NOW=$(date +%s)
DEADLINE=$(( NOW + 90 ))
CALLS=0
CURL_PID=""
ERR=""; ERR_DETAIL=""; ERR_HTTP=""

# --------------------------------------------------------------- utilities

emit_error() {  # CODE [DETAIL] [HTTP]
  jq -nc --arg e "$1" --arg d "${2:-}" --arg h "${3:-}" \
    '{v:1, error:$e} + (if $d != "" then {detail: ($d | gsub("[^[:print:]]"; " ") | .[0:120])} else {} end) + (if $h != "" then {http: ($h|tonumber)} else {} end)'
}

fail() {  # CODE [DETAIL] [HTTP] -> print + exit 0
  emit_error "$@"
  exit 0
}

# read_bounded FILE MAXBYTES: descriptor-first, no symlink follow, no FIFO block.
read_bounded() {
  dd if="$1" iflag=nofollow,nonblock bs=1 count="$2" 2>/dev/null
}

# publish DEST CONTENT: atomic owner-only write in DEST's own directory.
publish() {
  local dest="$1" content="$2" tmp
  tmp="$(mktemp -p "$(dirname "$dest")")" || return 1
  if ! printf '%s\n' "$content" > "$tmp"; then rm -f "$tmp"; return 1; fi
  chmod 600 "$tmp"
  sync "$tmp" 2>/dev/null
  mv -f -T "$tmp" "$dest"
}

read_json_file() {  # FILE FALLBACK -> valid JSON or FALLBACK
  local raw
  raw="$(read_bounded "$1" 262144 2>/dev/null)"
  if [[ -n "$raw" ]] && jq -e . >/dev/null 2>&1 <<<"$raw"; then printf '%s' "$raw"; else printf '%s' "$2"; fi
}

# ------------------------------------------------------- layer 2: the gate

if [[ -z "$FIXTURE_DIR" ]]; then
  jq -e --arg id "$PLUGIN_ID" '
    [.bar.layout[]?[]? | select((.id? // .) == $id)][0].querying
    | tostring | ascii_downcase | IN("true","1","yes","on")' \
    "$SHELL_JSON" >/dev/null 2>&1 || fail off
fi

# ------------------------------------------------- credentials + endpoint

if [[ -n "$FIXTURE_DIR" ]]; then
  KEY="pcm_fixture0000000000"
  ENDPOINT="https://fixture.invalid/mcp_connector/mcp"
else
  [[ -d "$CONF_DIR" && ! -L "$CONF_DIR" ]] || fail no_key
  KEY_FILE="$CONF_DIR/api_key"
  ENDPOINT_FILE="$CONF_DIR/endpoint"
  [[ -r "$KEY_FILE" ]] || fail no_key
  key_perms="$(stat -c %a "$KEY_FILE" 2>/dev/null || echo 000)"
  [[ "$key_perms" =~ ^[4-7]00$ ]] || fail key_perms
  KEY="$(read_bounded "$KEY_FILE" 256 | head -n1 | tr -d '[:space:]')"
  [[ "$KEY" =~ ^pcm_[0-9a-f]{16,128}$ ]] || fail no_key
  [[ -r "$ENDPOINT_FILE" ]] || fail bad_endpoint
  ENDPOINT="$(read_bounded "$ENDPOINT_FILE" 512 | head -n1 | tr -d '[:space:]')"
  [[ "$ENDPOINT" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?/mcp_connector/mcp$ ]] || fail bad_endpoint
fi

# ---------------------------------------------------------- cache + lock

mkdir -p "$CACHE_DIR"
[[ -d "$CACHE_DIR" && ! -L "$CACHE_DIR" ]] || fail parse_failed "cache dir"
chmod 700 "$CACHE_DIR"
LAST_FILE="$CACHE_DIR/last.json"
CURRENCIES_FILE="$CACHE_DIR/currencies.json"
CUSTOMERS_FILE="$CACHE_DIR/customers.json"

if (( FORCE == 0 )) && [[ -r "$LAST_FILE" ]]; then
  age=$(( NOW - $(stat -c %Y "$LAST_FILE" 2>/dev/null || echo 0) ))
  if (( age < RESULT_TTL )); then
    cached="$(read_json_file "$LAST_FILE" "")"
    if [[ -n "$cached" ]] && jq -e '.ok == true' >/dev/null 2>&1 <<<"$cached"; then
      jq -c '.fresh = false' <<<"$cached"
      exit 0
    fi
  fi
fi

exec 9>"$CACHE_DIR/lock"
flock -w 30 9 || fail deadline "lock"

WORK_DIR="$(mktemp -d)"
# The toggle kills this script (SIGTERM); the in-flight curl runs in the
# background and is waited on, so the trap fires at once and tears the HTTP
# request down instead of letting it complete.
trap 'kill "$CURL_PID" 2>/dev/null; rm -rf "$WORK_DIR"; trap - EXIT; exit 130' INT TERM
trap 'rm -rf "$WORK_DIR"' EXIT

# ------------------------------------------------------------ MCP calls

REQ_ID=0
MCP_OUT=""
LIST_OUT="[]"
DEBUG="${PERFEX_PULSE_DEBUG:-0}"

dbg() { (( DEBUG )) && printf 'perfex-pulse-fetch: %s\n' "$*" >&2; return 0; }

# mcp_call TOOL ARGS_JSON [MAX_TIME] -> 0 with the structuredContent JSON in
# MCP_OUT, or nonzero with ERR/ERR_DETAIL/ERR_HTTP set. Results travel in
# variables, never through $(...): a subshell would lose ERR and CALLS and,
# worse, CURL_PID - which the abort trap needs. Modern MCP era (2026-07-28):
# no initialize, no session, one POST per call.
mcp_call() {
  local tool="$1" args="$2" max_time="${3:-30}" body resp meta remaining code ctype rc payload
  ERR=""; ERR_DETAIL=""; ERR_HTTP=""; MCP_OUT=""
  remaining=$(( DEADLINE - $(date +%s) ))
  if (( remaining <= 2 )); then ERR=deadline; return 1; fi
  (( remaining < max_time )) && max_time=$remaining
  REQ_ID=$(( REQ_ID + 1 ))
  CALLS=$(( CALLS + 1 ))
  body="$WORK_DIR/req$REQ_ID.json"; resp="$WORK_DIR/resp$REQ_ID"; meta="$WORK_DIR/meta$REQ_ID"
  jq -nc --arg t "$tool" --argjson a "$args" --argjson id "$REQ_ID" \
    '{jsonrpc:"2.0", id:$id, method:"tools/call", params:{name:$t, arguments:$a,
      _meta:{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}}}}' > "$body"

  if [[ -n "$FIXTURE_DIR" ]]; then
    local fx="$FIXTURE_DIR/$tool.json"
    [[ -f "$FIXTURE_DIR/$tool.$REQ_ID.json" ]] && fx="$FIXTURE_DIR/$tool.$REQ_ID.json"
    if [[ -f "$fx" ]]; then cp "$fx" "$resp"; rc=0; else : > "$resp"; rc=7; fi
    if [[ -f "$FIXTURE_DIR/$tool.meta" ]]; then cp "$FIXTURE_DIR/$tool.meta" "$meta"; else printf '200 application/json' > "$meta"; fi
  else
    # curl's own stdout (-w) goes to the meta file, never to OUR stdout,
    # which is the one-line JSON the widget parses.
    curl -sS -g --connect-timeout 5 --max-time "$max_time" --max-filesize 4194304 -K - \
      -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \
      -H 'MCP-Protocol-Version: 2026-07-28' -H 'Mcp-Method: tools/call' -H "Mcp-Name: $tool" \
      -H 'User-Agent: perfex-pulse/1.0 (omarchy-bar)' \
      --data-binary @"$body" -o "$resp" -w '%{http_code} %{content_type}' \
      > "$meta" 2>/dev/null <<<"$(printf 'url = "%s"\nheader = "Authorization: Bearer %s"\n' "$ENDPOINT" "$KEY")" &
    CURL_PID=$!
    wait "$CURL_PID"; rc=$?
    CURL_PID=""
  fi
  dbg "$tool rc=$rc meta=$(cat "$meta" 2>/dev/null)"

  if (( rc != 0 )); then
    case "$rc" in
      6|7|28|35|56) ERR=unreachable; ERR_DETAIL="curl $rc" ;;
      63) ERR=protocol; ERR_DETAIL="response too large" ;;
      *) ERR=unreachable; ERR_DETAIL="curl $rc" ;;
    esac
    return 1
  fi
  # read returns nonzero at EOF without a newline (curl -w writes none) but
  # has already filled the variables, so the status is checked, not read's.
  code=""; ctype=""
  read -r code ctype < "$meta" || true
  code="${code:-000}"
  case "$code" in
    200) ;;
    401) ERR=auth; ERR_HTTP=401; ERR_DETAIL="HTTP 401"; return 1 ;;
    403) ERR=forbidden; ERR_HTTP=403; ERR_DETAIL="HTTP 403"; return 1 ;;
    429) ERR=rate_limited; ERR_HTTP=429; ERR_DETAIL="HTTP 429"; return 1 ;;
    404) ERR=bad_endpoint; ERR_HTTP=404; ERR_DETAIL="HTTP 404"; return 1 ;;
    5*) ERR=server; ERR_HTTP="$code"; ERR_DETAIL="HTTP $code"; return 1 ;;
    *) ERR=protocol; ERR_HTTP="${code:-0}"; ERR_DETAIL="HTTP $code"; return 1 ;;
  esac

  # SSE or plain JSON. In a stream, take the data line whose id matches
  # this request, so interleaved notifications cannot be mistaken for it.
  if [[ "$ctype" == *"text/event-stream"* ]] || grep -qE '^(event|data):' "$resp"; then
    payload="$(sed -n 's/^data: *//p' "$resp" | jq -c --argjson id "$REQ_ID" 'select(.id? == $id)' 2>/dev/null | tail -n1)"
  else
    payload="$(cat "$resp")"
  fi
  if [[ -z "$payload" ]] || ! jq -e . >/dev/null 2>&1 <<<"$payload"; then
    ERR=protocol; ERR_DETAIL="unparseable reply"; return 1
  fi
  if jq -e '.error' >/dev/null 2>&1 <<<"$payload"; then
    ERR=protocol; ERR_DETAIL="$(jq -r '.error.message // "rpc error"' <<<"$payload")"; return 1
  fi
  if jq -e '.result.isError == true' >/dev/null 2>&1 <<<"$payload"; then
    ERR=tool_error; ERR_DETAIL="$(jq -r '[.result.content[]? | .text? // empty] | join(" ")' <<<"$payload")"; return 1
  fi
  if ! jq -e '.result.structuredContent' >/dev/null 2>&1 <<<"$payload"; then
    ERR=protocol; ERR_DETAIL="no structured content"; return 1
  fi
  MCP_OUT="$(jq -c '.result.structuredContent' <<<"$payload")"
}

# list_all TOOL ARGS_JSON -> 0 with every row (paged) in LIST_OUT, or nonzero.
list_all() {
  local tool="$1" args="$2" offset=0 rows total pages=0 all="[]" pageArgs
  LIST_OUT="[]"
  while :; do
    pages=$(( pages + 1 ))
    (( pages > PAGE_CAP )) && break
    pageArgs="$(jq -c --argjson o "$offset" '. + {limit: 100, offset: $o}' <<<"$args")"
    mcp_call "$tool" "$pageArgs" || return 1
    rows="$(jq -c '.data // []' <<<"$MCP_OUT")"
    all="$(jq -c --argjson r "$rows" '. + $r' <<<"$all")"
    total="$(jq -r '.total // 0' <<<"$MCP_OUT")"
    offset=$(( offset + 100 ))
    (( offset >= total )) && break
  done
  LIST_OUT="$all"
}

# Abort the whole run on auth-class failures (one audit row, not many).
abort_if_hard() {
  case "$ERR" in
    auth|forbidden|rate_limited|bad_endpoint|deadline) fail "$ERR" "$ERR_DETAIL" "$ERR_HTTP" ;;
  esac
}

# ----------------------------------------------------------- the open book

all_rows="[]"
for status in 1 3 4; do
  list_all invoices_list "{\"status\":\"$status\"}" || { abort_if_hard; fail "$ERR" "$ERR_DETAIL" "$ERR_HTTP"; }
  all_rows="$(jq -c --argjson r "$LIST_OUT" '. + $r' <<<"$all_rows")"
done
dbg "open rows: $(jq 'length' <<<"$all_rows")"

TODAY="$(date +%F)"
open_json="$(jq -c --arg today "$TODAY" '
  map({id: (.id|tonumber), number: (.formatted_number // ("#" + (.id|tostring))),
       clientid: ((.clientid // 0)|tonumber), currency: ((.currency // 0)|tostring),
       total: ((.total // 0)|tonumber), duedate: (.duedate // null), status: ((.status // 0)|tonumber)})
  | map(.overdue = (.duedate != null and .duedate < $today))
  | unique_by(.id)
  | sort_by((if .overdue then 0 else 1 end), (if .overdue then .duedate else "" end), (-(.total)))' <<<"$all_rows")"

# ---------------------------------------------- per-invoice detail lookups

last_json="$(read_json_file "$LAST_FILE" '{}')"
currencies_json="$(read_json_file "$CURRENCIES_FILE" '{}')"
customers_json="$(read_json_file "$CUSTOMERS_FILE" '{}')"

details="{}"
skipped=0
fetched=0
for id in $(jq -r '.[].id' <<<"$open_json"); do
  if (( fetched >= GET_CAP )); then skipped=$(( skipped + 1 )); continue; fi
  fetched=$(( fetched + 1 ))
  if mcp_call invoices_get "{\"id\":$id}" 20; then
    if d="$(jq -c '.invoice | {balance: ((.total_left_to_pay // .total // 0)|tonumber), symbol: (.symbol // ""),
                    currency_name: (.currency_name // ""), currencyid: ((.currencyid // .currency // 0)|tostring),
                    client: (.client.company // "")}' <<<"$MCP_OUT" 2>/dev/null)"; then
      details="$(jq -c --arg id "$id" --argjson d "$d" '. + {($id): $d}' <<<"$details")"
      continue
    fi
  else
    abort_if_hard
  fi
  skipped=$(( skipped + 1 ))
done

# Currency symbols learned from the gets, kept for rows beyond the cap.
currencies_json="$(jq -c --argjson d "$details" '
  reduce ($d | to_entries[] | .value | select(.symbol != "")) as $v (.; . + {($v.currencyid): {symbol: $v.symbol, name: $v.currency_name}})' <<<"$currencies_json")"
publish "$CURRENCIES_FILE" "$currencies_json" || true

# Customer names, refreshed daily, for rows beyond the cap. Best effort.
customers_age=$(( NOW - $(stat -c %Y "$CUSTOMERS_FILE" 2>/dev/null || echo 0) ))
if (( customers_age >= CUSTOMERS_TTL )); then
  if list_all customers_list '{}'; then
    customers_json="$(jq -c 'map({key: (.userid|tostring), value: (.company // "")}) | from_entries' <<<"$LIST_OUT")"
    publish "$CUSTOMERS_FILE" "$customers_json" || true
  else
    abort_if_hard
  fi
fi

# ----------------------------------------------------- paid this month

paid_json='{"symbol":"","total":0,"count":0,"rows":[]}'
if (( WANT_PAYMENTS == 1 )); then
  if list_all payments_list '{}'; then
    paid_json="$(jq -c --arg m "$(date +%Y-%m-01)" '
      [.[] | select((.date // "") >= $m)] as $p
      | {symbol: "", total: ($p | map((.amount // 0)|tonumber) | add // 0), count: ($p|length),
         rows: ($p | sort_by(.daterecorded // .date) | reverse | .[0:5]
                | map({date: (.date // ""), invoiceid: ((.invoiceid // 0)|tonumber), amount: ((.amount // 0)|tonumber), mode: (.paymentmode // "")}))}' <<<"$LIST_OUT")"
  else
    abort_if_hard
  fi
fi

# --------------------------------------------------------------- compose

END_MS=$(( $(date +%s%N) / 1000000 ))
result="$(jq -nc --argjson open "$open_json" --argjson details "$details" --argjson last "$last_json" \
  --argjson customers "$customers_json" --argjson currencies "$currencies_json" --arg today "$TODAY" \
  --argjson now "$NOW" --argjson rows "$OVERDUE_ROWS" --argjson skipped "$skipped" \
  --argjson calls "$CALLS" --argjson ms "$(( END_MS - START_MS ))" --argjson paid "$paid_json" '
  def days($d): ((($today|strptime("%Y-%m-%d")|mktime) - ($d|strptime("%Y-%m-%d")|mktime)) / 86400 | floor);
  ($last.balances // {}) as $lb
  | [ $open[] | . as $o | ($details[($o.id|tostring)]) as $d
      | .balance = (if $d then $d.balance elif $lb[($o.id|tostring)] then $lb[($o.id|tostring)] else $o.total end)
      | .approx = ($d == null)
      | .symbol = (if ($d and $d.symbol != "") then $d.symbol elif $currencies[$o.currency] then $currencies[$o.currency].symbol else "" end)
      | .currency_name = (if ($d and $d.currency_name != "") then $d.currency_name elif $currencies[$o.currency] then $currencies[$o.currency].name else "" end)
      | .client = (if ($d and $d.client != "") then $d.client elif $customers[($o.clientid|tostring)] then $customers[($o.clientid|tostring)] else ("Client #" + ($o.clientid|tostring)) end)
      | .days_overdue = (if .overdue then days(.duedate) else 0 end)
    ] as $inv
  | ($inv | group_by(.currency) | map({
        id: .[0].currency, symbol: .[0].symbol, name: .[0].currency_name,
        outstanding: (map(.balance) | add // 0),
        overdue: {count: (map(select(.overdue)) | length), total: (map(select(.overdue) | .balance) | add // 0)},
        unpaid:  {count: (map(select((.overdue|not) and .status != 3)) | length), total: (map(select((.overdue|not) and .status != 3) | .balance) | add // 0)},
        partial: {count: (map(select((.overdue|not) and .status == 3)) | length), total: (map(select((.overdue|not) and .status == 3) | .balance) | add // 0)}})
      | sort_by(-.outstanding)) as $cur
  | {v: 1, ok: true, updated: $now, fresh: true, approx: ($inv | any(.approx)),
     currencies: $cur,
     overdue_invoices: ([$inv[] | select(.overdue)] | sort_by(.duedate) | .[0:$rows]
                        | map({id, number, clientid, client, symbol, balance, duedate, days_overdue})),
     open_count: ($inv | length), skipped_gets: $skipped,
     balances: ($inv | map({key: (.id|tostring), value: .balance}) | from_entries),
     paid_month: ($paid | .symbol = ($cur[0].symbol // "")),
     meta: {calls: $calls, ms: $ms}}')" || fail parse_failed "compose"

publish "$LAST_FILE" "$result" || true
printf '%s\n' "$result"
